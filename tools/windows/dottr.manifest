<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Application manifest of the dottr programs on Windows. The active code page
  UTF-8 makes the narrow-string functions of the C runtime, such as fopen and
  the arguments of main, use UTF-8, as on Linux and macOS (Windows 10 1903
  and later).
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
