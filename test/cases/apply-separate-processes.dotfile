# args: apply
# status: 0
# os: linux, macos
unit a do
  apply do
    shell do
      ```
      cd "$HOME"
      DOTTR_TEST_VAR=set
      export DOTTR_TEST_VAR
      ```
    end
    shell do
      ```
      if [ "$(pwd)" = "$HOME" ]; then
        echo "working directory carried over"
      else
        echo "working directory not carried over"
      fi
      echo "variable: ${DOTTR_TEST_VAR:-unset}"
      ```
    end
  end
end
