# args: plan --package-manager brew
# status: 0
# The view of a manifest with `on` blocks on brew.
pkg git

on macos do
  pkg rectangle
end

unit neovim do
  on linux, macos do
    pkg neovim
  end
  on windows do
    pkg "Neovim.Neovim"
  end
end

unit fd do
  on pacman, dnf, brew do
    pkg fd
  end
  on apt do
    pkg "fd-find"
  end
  on windows do
    pkg "sharkdp.fd"
  end
end

unit tpm do
  needs git
  on linux, macos do
    local TPM_DIR = "/nonexistent/linux/tpm"
  end
  on windows do
    local TPM_DIR = "/nonexistent/windows/tpm"
  end
  check directory TPM_DIR
  apply_unless TPM_DIR do
    on linux, macos do
      shell do
        ```
        git clone https://github.com/tmux-plugins/tpm "$TPM_DIR"
        ```
      end
    end
    on windows do
      shell do
        ```
        git clone https://github.com/tmux-plugins/tpm $env:TPM_DIR
        ```
      end
    end
  end
end
