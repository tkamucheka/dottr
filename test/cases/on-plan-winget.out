unit git
  install package git: winget install --exact --silent --accept-package-agreements --accept-source-agreements --id git

unit neovim
  install package Neovim.Neovim (child unit neovim-child-Neovim.Neovim): winget install --exact --silent --accept-package-agreements --accept-source-agreements --id Neovim.Neovim

unit fd
  install package sharkdp.fd (child unit fd-child-sharkdp.fd): winget install --exact --silent --accept-package-agreements --accept-source-agreements --id sharkdp.fd

unit tpm
  needs git
  local TPM_DIR = "/nonexistent/windows/tpm"
  check directory TPM_DIR: /nonexistent/windows/tpm (currently false)
  apply_unless TPM_DIR
    shell (sh)
      git clone https://github.com/tmux-plugins/tpm $env:TPM_DIR
